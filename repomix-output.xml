<script setup lang="ts">
import { ref } from 'vue'

const { getStoreUrl, track } = useStore()

const items = [
  { key: 'countertops', title: 'Countertops', desc: 'Granite, quartz and marble, cut to measure', img: 'photo-1556911220-bff31c812dba' },
  { key: 'kitchen', title: 'Kitchen sinks and taps', desc: 'Sinks, mixers and pull-out taps', img: 'photo-1556909114-f6e7ad7d3136' },
  { key: 'faucets', title: 'Faucets', desc: 'Basin and bath taps', img: 'photo-1584622650111-993a426fbf0a' },
  { key: 'showers', title: 'Showers and shower sets', desc: 'Rain heads, hand showers, full sets', img: 'photo-1507652313519-d4e9174996dd' },
  { key: 'sinks', title: 'Bathroom sinks and vanities', desc: 'Vanity units and basins', img: 'photo-1620626011761-996317b8d101' },
  { key: 'pedestals', title: 'Pedestal basins', desc: 'Clean lines for smaller spaces', img: 'photo-1631889993959-41b4e9c6e3c5' },
  { key: 'toilets', title: 'Toilets and seats', desc: 'Easy-fit, soft-close options', img: 'photo-1600566753086-00f18fb6b3ea' }
]

const currentImg = ref(items[0].img)
const isFading = ref(false)

function onPreview(imgId: string) {
  if (currentImg.value === imgId) return
  isFading.value = true
  setTimeout(() => {
    currentImg.value = imgId
    isFading.value = false
  }, 180)
}
</script>

<template>
	<section id="collection" style="padding-top: 0;">
		<div class="wrap">
			<h2>The collection</h2>
			<div class="coll">
				<div class="rows">
					<a v-for="item in items" :key="item.key" class="row" :href="getStoreUrl(item.key)"
						@mouseenter="onPreview(item.img)" @focus="onPreview(item.img)"
						@click="track('store_click', { category: item.key })">
						<div>
							<h3>{{ item.title }}</h3>
							<small>{{ item.desc }}</small>
						</div>
						<div class="ph th">
							<img :src="`https://images.unsplash.com/${item.img}?auto=format&fit=crop&w=200&q=70`" alt=""
								loading="lazy" />
						</div>
						<span class="go">Shop</span>
					</a>
				</div>

				<div class="ph pv">
